{
  "name": "qlvpp-api",
  "version": "4.0.0",
  "description": "QLVPP API — Node.js 20 + Express + Clean Architecture",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --coverage --verbose --forceExit",
    "test:unit": "jest src/__tests__/unit --verbose",
    "test:integration": "jest src/__tests__/integration --verbose",
    "test:ci": "jest --coverage --ci --forceExit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.76.5",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mysql-session": "^3.0.0",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.10.1",
    "morgan": "^1.10.0",
    "multer": "^2.0.0-rc.1",
    "mysql2": "^3.10.1",
    "nodemailer": "^8.0.7",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "jest": {
    "setupFiles": [
      "<rootDir>/src/__tests__/setup.js"
    ],
    "testEnvironment": "node",
    "testMatch": [
      "**/src/__tests__/**/*.test.js"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/__tests__/**",
      "!src/shared/config/**",
      "!src/shared/docs/**",
      "!src/shared/logger/**",
      "!server.js",
      "!app.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "verbose": true
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
