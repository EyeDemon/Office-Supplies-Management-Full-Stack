# ═══════════════════════════════════════════════════════════════════
# QLVPP — Root .env.example
# Dùng cho Docker Compose deployment (docker-compose.yml đọc file này)
# Sao chép: cp .env.example .env  rồi thay toàn bộ CHANGE_ME
# ═══════════════════════════════════════════════════════════════════

# ── Docker MySQL credentials ───────────────────────────────────────
MYSQL_ROOT_PASSWORD=CHANGE_ME_strong_root_password
MYSQL_PASSWORD=CHANGE_ME_app_password

# ── Database (Backend kết nối — dùng qlvpp_user khi chạy Docker) ──
DB_HOST=localhost
DB_PORT=3306
DB_NAME=qlvpp
DB_USER=qlvpp_user
DB_PASSWORD=CHANGE_ME_app_password

# ── Server ────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development

# ── Session (REQUIRED: tối thiểu 32 ký tự ngẫu nhiên) ───────────
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=CHANGE_ME_replace_with_64_random_hex_chars_generated_above

# ── CORS (URL frontend truy cập backend) ─────────────────────────
# Dev: http://localhost:5173 (Vite dev server)
# Docker: http://localhost (Nginx port 80)
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ── Email (tuỳ chọn — nếu không set thì log ra console ở dev) ────
EMAIL_MODE=dev
# EMAIL_MODE=smtp   ← bỏ comment và điền thông tin dưới khi muốn gửi mail thật
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM="QLVPP <noreply@qlvpp.com>"
# Ngưỡng điều chỉnh tồn kho cần phê duyệt (số lượng tuyệt đối)
ADJUSTMENT_THRESHOLD=100
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password